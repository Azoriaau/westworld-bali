---
import { whatsappLink } from '../lib/format';
---

<a
  href={whatsappLink()}
  target="_blank"
  rel="noopener"
  transition:persist="whatsapp"
  class="group fixed right-4 bottom-4 z-40 inline-flex size-14 items-center justify-center rounded-full bg-ocean text-linen shadow-[0_10px_30px_-10px_rgb(47_79_79/0.6)] transition-colors duration-300 hover:bg-ocean-dark md:right-6 md:bottom-6"
  aria-label="Chat with us on WhatsApp (opens in a new tab)"
>
  <svg viewBox="0 0 32 32" class="size-7" fill="currentColor" aria-hidden="true">
    <path
      d="M16.04 3C8.86 3 3.03 8.82 3.03 16c0 2.3.6 4.54 1.74 6.52L3 29l6.65-1.74A12.9 12.9 0 0 0 16.04 29C23.2 29 29 23.18 29 16S23.2 3 16.04 3Zm0 23.74c-1.95 0-3.86-.53-5.53-1.52l-.4-.24-3.95 1.03 1.05-3.85-.26-.4A10.7 10.7 0 0 1 5.3 16c0-5.92 4.82-10.74 10.75-10.74 5.92 0 10.73 4.82 10.73 10.74 0 5.93-4.81 10.74-10.73 10.74Zm5.89-8.04c-.32-.16-1.91-.94-2.2-1.05-.3-.11-.51-.16-.73.16-.21.32-.83 1.05-1.02 1.27-.19.21-.38.24-.7.08-.32-.16-1.36-.5-2.59-1.6-.96-.85-1.6-1.9-1.8-2.22-.18-.32-.02-.5.15-.66.14-.14.32-.38.48-.56.16-.19.21-.32.32-.54.1-.21.05-.4-.03-.56-.08-.16-.72-1.74-1-2.38-.26-.62-.52-.54-.72-.55h-.62c-.21 0-.56.08-.85.4-.3.32-1.12 1.1-1.12 2.67 0 1.58 1.15 3.1 1.3 3.32.17.21 2.26 3.45 5.47 4.84.77.33 1.36.53 1.83.67.77.25 1.47.21 2.02.13.62-.09 1.91-.78 2.18-1.53.27-.75.27-1.4.19-1.53-.08-.13-.3-.21-.61-.37Z"
