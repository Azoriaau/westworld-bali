---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { site } from '../site.config';
import defaultImage from '../assets/images/home/hero.jpg';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  noindex?: boolean;
}

const { title, description = site.description, image = defaultImage, imageAlt = site.name, noindex = false } = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} — Luxury villas in ${site.location.area}, Bali`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site ?? site.url);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
