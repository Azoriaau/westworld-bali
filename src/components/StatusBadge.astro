---
interface Props {
  status: 'Available' | 'Reserved' | 'Sold';
  class?: string;
}
const { status, class: className } = Astro.props;

const styles = {
  Available: 'bg-seafoam text-ocean-dark',
  Reserved: 'bg-sand text-ocean-dark',
  Sold: 'bg-ocean text-linen',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[0.6875rem] font-semibold tracking-[0.16em] uppercase',
    styles[status],
    className,
  ]}
>
  <span class="size-1.5 rounded-full bg-current opacity-70" aria-hidden="true"></span>
  {status}
</span>
