---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, lead, image, imageAlt = '' } = Astro.props;
---

<section class="pt-32 md:pt-40">
  <div class="container-site">
    <p class="eyebrow rise">{eyebrow}</p>
    <h1 class="rise mt-4 max-w-4xl text-5xl md:text-7xl">{title}</h1>
    {lead && <p class="rise rise-2 mt-6 max-w-2xl text-lg text-driftwood-dark md:text-xl">{lead}</p>}
    <slot />
  </div>
  {
    image && (
      <div class="container-site mt-12 md:mt-16">
        <Image
          src={image}
          alt={imageAlt}
          widths={[640, 960, 1280, 1600, 2000]}
          sizes="(min-width: 1280px) 1200px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[16/9] w-full rounded-soft object-cover md:aspect-[21/9]"
        />
      </div>
    )
  }
</section>
