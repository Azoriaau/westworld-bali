---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import Lightbox from '../../components/Lightbox.astro';
import VillaCard from '../../components/VillaCard.astro';
import { formatArea, formatPrice, getVillas, whatsappLink, type Villa } from '../../lib/format';

export const getStaticPaths = (async () => {
  const villas = await getVillas();
  return villas.map((villa) => ({ params: { slug: villa.id }, props: { villa, all: villas } }));
}) satisfies GetStaticPaths;

interface Props {
  villa: Villa;
  all: Villa[];
}

const { villa, all } = Astro.props;
const { data } = villa;
const { Content } = await render(villa);

// Large versions for the lightbox
const gallery = await Promise.all(
  data.gallery.map(async (item) => ({
    ...item,
    large: (await getImage({ src: item.src, width: 1800, format: 'webp' })).src,
  })),
);
const floorPlanLarge = data.floorPlan ? (await getImage({ src: data.floorPlan, width: 2000, format: 'webp' })).src : null;

const specs = [
  { label: 'Bedrooms', value: String(data.bedrooms) },
  { label: 'Bathrooms', value: String(data.bathrooms) },
  { label: 'Land size', value: formatArea(data.landSize) },
  { label: 'Building size', value: formatArea(data.buildingSize) },
  { label: 'Pool', value: data.pool },
  { label: 'Ownership', value: data.ownership },
];

const others = all.filter((v) => v.id !== villa.id).slice(0, 2);
---

<BaseLayout title={data.name} description={data.summary} image={data.heroImage} imageAlt={data.heroAlt}>
  <!-- Hero + summary bar together fill the first viewport; the hero stretches to whatever the bar leaves free -->
  <div class="flex min-h-svh flex-col">
  <!-- Hero: shares a transition name with the villa card image so it morphs between pages -->
  <section class="relative isolate flex flex-1 items-end overflow-hidden bg-sand">
    <Image
      src={data.heroImage}
      alt={data.heroAlt}
      widths={[640, 960, 1280, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 size-full object-cover"
      transition:name={`villa-image-${villa.id}`}
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ocean-dark/70 via-ocean-dark/10 to-transparent"></div>
    <div class="container-site pt-32 pb-12 text-linen md:pb-20">
      <nav aria-label="Breadcrumb" class="rise text-xs font-semibold tracking-[0.22em] uppercase">
        <a href="/villas/" class="link-underline">Villas</a>
        <span aria-hidden="true" class="mx-2 opacity-70">/</span>
        <span aria-current="page">{data.name}</span>
      </nav>
      <h1 class="rise mt-4 text-6xl md:text-8xl">{data.name}</h1>
      <p class="rise rise-2 mt-4 max-w-2xl text-lg md:text-xl">{data.tagline}</p>
    </div>
  </section>

  <!-- Summary bar -->
  <section class="border-b border-sand bg-linen">
    <div class="container-site flex flex-col gap-5 py-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="rise rise-2 flex items-center gap-5">
        <StatusBadge status={data.status} />
        <p class="font-serif text-2xl md:text-3xl">
          {data.status === 'Sold' ? 'Sold' : <><span class="font-sans text-sm tracking-[0.14em] text-driftwood-dark uppercase">From </span>{formatPrice(data.priceFrom)}</>}
        </p>
      </div>
      <div class="rise rise-3 flex flex-col gap-3 sm:flex-row">
        <a href="#enquire" class="btn btn-primary">Enquire about {data.name}</a>
        <a href={whatsappLink(`Hi, I'm interested in ${data.name}.`)} target="_blank" rel="noopener" class="btn btn-outline">WhatsApp</a>
      </div>
    </div>
  </section>
  </div>

  <!-- Description + specs -->
  <section class="py-20 md:py-28">
    <div class="container-site grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="prose-villa rise rise-3 text-lg text-driftwood-dark lg:col-span-7 [&>p:first-child]:text-ocean">
        <Content />
      </div>
      <aside class="lg:col-span-5" aria-labelledby="specs-heading">
        <div class="rounded-soft bg-sand-light p-8 md:p-10" data-reveal>
          <h2 id="specs-heading" class="text-3xl">Key details</h2>
          <dl class="mt-6 divide-y divide-sand">
            {
              specs.map((s) => (
                <div class="flex justify-between gap-6 py-3.5">
                  <dt class="text-sm tracking-[0.12em] text-driftwood-dark uppercase">{s.label}</dt>
                  <dd class="text-right font-medium">{s.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <!-- Gallery -->
  {
    gallery.length > 0 && (
      <section class="pb-20 md:pb-28" aria-labelledby="gallery-heading">
        <div class="container-site">
          <h2 id="gallery-heading" class="text-4xl md:text-5xl" data-reveal>
            Gallery
          </h2>
          <ul class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
            {gallery.map((item, i) => (
              <li class:list={[i === 0 && 'col-span-2 row-span-2']} data-reveal style={`--reveal-delay: ${(i % 4) * 0.08}s`}>
                <a
                  href={item.large}
                  data-lightbox={villa.id}
                  data-caption={item.alt}
                  data-astro-reload
                  class="group block h-full overflow-hidden rounded-soft bg-sand"
                >
                  <Image
                    src={item.src}
                    alt={item.alt}
                    widths={i === 0 ? [640, 960, 1280] : [320, 480, 640]}
                    sizes={i === 0 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
                    class="aspect-square size-full object-cover transition-transform duration-700 ease-soft group-hover:scale-[1.04]"
                  />
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-driftwood-dark">Select an image to view it full screen.</p>
        </div>
      </section>
    )
  }

  <!-- Floor plan + amenities -->
  <section class="bg-sand-light py-20 md:py-28">
    <div class="container-site grid gap-14 lg:grid-cols-12 lg:gap-20">
      {
        data.floorPlan && floorPlanLarge && (
          <div class="lg:col-span-7" data-reveal>
            <h2 class="text-4xl md:text-5xl">Floor plan</h2>
            <a
              href={floorPlanLarge}
              data-lightbox={`${villa.id}-plan`}
              data-caption={data.floorPlanAlt}
              data-astro-reload
              class="mt-8 block overflow-hidden rounded-soft border border-sand bg-white"
            >
              <Image src={data.floorPlan} alt={data.floorPlanAlt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 55vw, 100vw" class="w-full" />
            </a>
            <p class="mt-3 text-sm text-driftwood-dark">Indicative only. Select to enlarge.</p>
          </div>
        )
      }
      <div class:list={[data.floorPlan ? 'lg:col-span-5' : 'lg:col-span-12']} data-reveal style="--reveal-delay: .12s">
        <h2 class="text-4xl md:text-5xl">Amenities</h2>
        <ul class="mt-8 space-y-4">
          {
            data.amenities.map((a) => (
              <li class="flex gap-4 border-b border-sand pb-4">
                <svg viewBox="0 0 24 24" class="mt-1 size-5 shrink-0 text-driftwood" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
                <span>{a}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Enquiry -->
  <section id="enquire" class="py-20 md:py-28">
    <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">Enquire</p>
        <h2 class="mt-4 text-4xl md:text-5xl">Interested in {data.name}?</h2>
        <p class="mt-5 text-lg text-driftwood-dark">
          Request the full information pack, pricing schedule and rental projections, or book a private viewing.
        </p>
      </div>
      <div class="lg:col-span-8" data-reveal style="--reveal-delay: .12s">
        <EnquiryForm villaName={data.name} compact />
      </div>
    </div>
  </section>

  <!-- More villas -->
  {
    others.length > 0 && (
      <section class="border-t border-sand py-20 md:py-28" aria-labelledby="more-heading">
        <div class="container-site">
          <h2 id="more-heading" class="text-4xl md:text-5xl" data-reveal>
            More villas
          </h2>
          <div class="mt-12 grid gap-x-8 gap-y-16 sm:grid-cols-2">
            {others.map((v) => (
              <div data-reveal>
                <VillaCard villa={v} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Lightbox />
</BaseLayout>
