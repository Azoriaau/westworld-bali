---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="flex min-h-[80svh] items-center pt-32 pb-24">
    <div class="container-site max-w-2xl text-center">
      <p class="eyebrow rise">404</p>
      <h1 class="rise mt-4 text-5xl md:text-7xl">Lost at sea</h1>
      <p class="rise rise-2 mt-6 text-lg text-driftwood-dark">The page you're looking for has drifted away.</p>
      <div class="rise rise-3 mt-10"><a href="/" class="btn btn-primary">Return home</a></div>
    </div>
  </section>
</BaseLayout>
